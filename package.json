{
  "name": "giftshop-vku",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node server.js",
    "test": "node --test tests/*.test.js",
    "check": "node scripts/check-syntax.mjs",
    "demo": "node scripts/run-demo.mjs",
    "test:browser": "playwright test",
    "project:plan": "node scripts/setup-project.mjs",
    "project:apply": "node scripts/setup-project.mjs --apply",
    "project:snapshot": "node scripts/snapshot-project.mjs",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{js,mjs,css,html}\" \"*.json\" \"config/*.json\"",
    "format:check": "prettier --check \"**/*.{js,mjs,css,html}\" \"*.json\" \"config/*.json\""
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.58.2",
    "eslint": "10.15.0",
    "globals": "16.5.0",
    "prettier": "3.6.2"
  }
}
